{
  "name": "survival-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env src/main.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "voice:check": "node scripts/voice-check.js",
    "test:server": "node scripts/server-test.js",
    "server:prepare": "node --use-env-proxy scripts/prepare-server.js"
  },
  "dependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "minecraft-data": "3.117.0",
    "vec3": "0.1.10",
    "discord.js": "14.27.0",
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5",
    "zod": "4.3.6"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "prismarine-nbt": "2.8.0"
  }
}
